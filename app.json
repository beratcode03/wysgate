{
  "expo": {
    "name": "Wysgate",
    "owner": "wysteria3",
    "slug": "wysgate",
    "version": "1.3.6",
    "description": "Kişiler için geliştirilmiş güçlü, güvenlikli ve kişiye özel parola uygulaması.",
    "orientation": "portrait",
    "icon": "./assets/images/W.png",
    "scheme": "wysgate",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#09090B",
      "image": "./assets/images/W.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Wysgate kasasını Face ID ile açmak için kullanılır."
      },
      "splash": {
        "backgroundColor": "#09090B",
        "image": "./assets/images/W.png",
        "resizeMode": "contain"
      }
    },
    "android": {
      "package": "com.wisteriae.wysgate",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/W.png",
        "backgroundColor": "#09090B"
      }
    },
    "web": {
      "favicon": "./assets/images/W.png"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-sharing"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}